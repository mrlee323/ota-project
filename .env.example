# ════════════════════════════════════════════════════════════════════════════
#  cp .env.example .env.local  하고 아래 「■ 붙여넣기」 5칸만 채우면 된다.
#  ■ 이 없는 줄은 이미 채워져 있으니 그대로 둔다.
#  자세한 설명: docs/md/onboarding.md §3
# ════════════════════════════════════════════════════════════════════════════


# ─── Supabase ───────────────────────────────────────────────────────────────
# 받는 곳 (한 화면에 세 개가 다 있다):
#   https://supabase.com/dashboard/project/aapvsizzcugmfsxakpvi/settings/api-keys
#
# ⚠️ 새 키 체계라 anon / service_role 이라는 이름이 없다:
#      Publishable key (sb_publishable_…) = 예전 anon
#      Secret key      (sb_secret_…)      = 예전 service_role  → admin_service_role 쪽
#    변수 «이름» 은 바꾸지 않는다. Vercel 에도 같은 이름으로 있어서 바꾸면 배포가 깨진다.

NEXT_PUBLIC_SUPABASE_URL=https://aapvsizzcugmfsxakpvi.supabase.co

# ■ 붙여넣기 ①  Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ■ 붙여넣기 ②  Secret key (Reveal 눌러야 보인다). 없으면 어드민이 전부 500 이다
SUPABASE_SERVICE_ROLE_KEY=


# ─── MD 자동화 · L1 (요청서 → 초안) ─────────────────────────────────────────
# OpenAI 호환 엔드포인트면 무엇이든 된다. 공급자를 바꾸려면 이 세 줄만 고친다.
# 지금은 Google AI Studio — 카드 없이 즉시 발급된다.
#   https://aistudio.google.com/apikey
#
# (Cerebras 는 2026-09 기준 추론에 카드 등록을 요구해 제외했다 — docs/md/llm.md §2)

LLM_EXTRACT_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_EXTRACT_MODEL=gemini-2.5-flash

# ■ 붙여넣기 ③  Google AI Studio API key
LLM_EXTRACT_KEY=


# ─── MD 자동화 · L3 (이미지 생성) ───────────────────────────────────────────
# GEMINI_API_KEY 는 위 ③ 과 «같은 값» 을 넣으면 된다 (같은 Google AI Studio 키).
# HF_API_TOKEN 은 여기서: https://huggingface.co/settings/tokens  (Read 권한이면 충분)
#
# HF 는 자체 추론을 내리고 외부 공급자 라우팅으로 옮겼다. 410 이 나면 여기만 고친다.
# 살아 있는 공급자 확인:
#   https://huggingface.co/api/models/black-forest-labs/FLUX.1-schnell?expand[]=inferenceProviderMapping

# ■ 붙여넣기 ④  ③ 과 같은 값
GEMINI_API_KEY=

# ■ 붙여넣기 ⑤  HuggingFace access token
HF_API_TOKEN=

HF_IMAGE_PROVIDER=nscale
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell


# ─── MCP ────────────────────────────────────────────────────────────────────
# 받아오는 값이 «아니다». 아무 임의 문자열이면 된다. 아래로 만들어 붙인다:
#   openssl rand -base64 32
#
# 정식 토큰은 어드민 /admin/content/md 의 「토큰 발급」에서 받는다 (docs/md/mcp.md §5).
# 이건 그게 없을 때의 개발용 탈출구다.

MCP_DEV_TOKEN=


# ─── 안 채워도 되는 것 ──────────────────────────────────────────────────────
# 쇼케이스 배치 생성용이고 MD 자동화와 무관하다. 비워 두면 MD 는 전부 동작한다.

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
NEXT_PUBLIC_API_BASE=
