# ─── Supabase ───────────────────────────────────────────────────────────────
# 없으면 빌드가 프리렌더 단계에서 실패한다 (infrastructure/supabase/env.ts 가 검증)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── 기존 AI 배관 (쇼케이스 타이틀·이미지) ──────────────────────────────────
GEMINI_API_KEY=
HF_API_TOKEN=

# ─── Inngest (쇼케이스 배치 생성 — MD 자동화와 무관) ────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── MD 자동화 · L1 값 추출 (docs/md/llm.md §2) ─────────────────────────────
# OpenAI 호환 엔드포인트면 무엇이든 된다. 공급자 교체는 이 세 줄만 바꾼다.
# 기본: Google AI Studio (카드 없이 발급 — aistudio.google.com/apikey)
# Cerebras 는 2026-09 기준 추론에 카드 등록을 요구해 제외했다.
LLM_EXTRACT_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_EXTRACT_KEY=
LLM_EXTRACT_MODEL=gemini-2.5-flash

# ─── MD 자동화 · MCP (docs/md/mcp.md §5) ────────────────────────────────────
# S0 스파이크용 단일 토큰. M3 에서 md_mcp_tokens 테이블로 교체한다.
MCP_DEV_TOKEN=

# ─── 기타 ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=
